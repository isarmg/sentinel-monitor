# Reference for the environment file created at
# /etc/isarmg/sentinel-monitor.env by the installed 0.2.1
# bootstrap script. Do not copy this template into the source tree.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite:///var/lib/isarmg/sentinel-monitor/db/app.db

# At least 32 random characters.
APP_JWT_SECRET=replace-with-at-least-32-random-characters

# Exactly 32 random bytes, encoded as base64.
CREDENTIALS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password
APP_ENV=production
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_HOURS=12
LOGIN_BODY_LIMIT_BYTES=16384
LOGIN_RATE_CAPACITY=4096
LOGIN_SOURCE_ATTEMPTS=30
LOGIN_SOURCE_WINDOW_SECS=60
LOGIN_ACCOUNT_ATTEMPTS=10
LOGIN_ACCOUNT_WINDOW_SECS=300
LOGIN_ARGON2_PARALLELISM=2
LOGIN_ARGON2_TIMEOUT_MS=5000

MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
MEDIAMTX_CONFIG=/opt/isarmg/sentinel-monitor/releases/0.2.1/config/mediamtx.yml
MEDIAMTX_CONTRACT=/opt/isarmg/sentinel-monitor/releases/0.2.1/config/mediamtx.lock
MEDIAMTX_BINARY=/opt/isarmg/sentinel-monitor/releases/0.2.1/bin/mediamtx
RECORDINGS_DIR=/var/lib/isarmg/sentinel-monitor/recordings
SENTINEL_RUNTIME_DIR=/run/isarmg/sentinel-monitor
PUBLIC_WEBRTC_BASE_URL=/media-webrtc
PUBLIC_HLS_BASE_URL=/media-hls

# IP or DNS name browsers use to reach this machine. For LAN access, replace
# 127.0.0.1 with the server's LAN IP. Multiple values are comma-separated.
MEDIA_PUBLIC_HOSTS=127.0.0.1

STATIC_DIR=/opt/isarmg/sentinel-monitor/releases/0.2.1/web

# Retention and runtime tuning.
RECORD_DELETE_AFTER=168h
STATUS_INTERVAL_SECS=10
RECONCILE_INTERVAL_SECS=60
REQUEST_TIMEOUT_SECS=20
RUST_LOG=info,tower_http=info
