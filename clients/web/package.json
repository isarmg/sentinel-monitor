    "build": "npm run check:foundation && npm run typecheck && vite build"
  },
  "dependencies": {
    "@sarmg/admin-web": "https://github.com/isarmg/sarmg-foundation/releases/download/v0.3.0/sarmg-admin-web-0.3.0.tgz",
    "@sarmg/contracts": "https://github.com/isarmg/sarmg-foundation/releases/download/v0.3.0/sarmg-contracts-0.3.0.tgz",
    "@sarmg/design-tokens": "https://github.com/isarmg/sarmg-foundation/releases/download/v0.3.0/sarmg-design-tokens-0.3.0.tgz",
    "@sarmg/http-client": "https://github.com/isarmg/sarmg-foundation/releases/download/v0.3.0/sarmg-http-client-0.3.0.tgz",
    "hls.js": "1.6.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
