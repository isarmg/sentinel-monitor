{$SITE_ADDRESS::80} {
    encode zstd gzip

    # Only the public WHEP and HLS listeners are proxied. MediaMTX API,
    # playback API and metrics remain bound to loopback and are never exposed.
    handle_path /media-webrtc/* {
        reverse_proxy 127.0.0.1:8889
    }

    handle_path /media-hls/* {
        reverse_proxy 127.0.0.1:8888
    }

    # Sentinel serves both the administrator API and the immutable Web build.
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}
