# Copy this file to .env before starting the stack.
POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=replace-with-a-long-database-password

# At least 32 random characters.
APP_JWT_SECRET=replace-with-at-least-32-random-characters

# Exactly 32 random bytes, encoded as base64.
CREDENTIALS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password
SESSION_COOKIE_SECURE=false

# IP or DNS name browsers use to reach this machine. For LAN access, replace
# 127.0.0.1 with the server's LAN IP. Multiple values are comma-separated.
MEDIA_PUBLIC_HOSTS=127.0.0.1

# Use :80 for local/LAN HTTP. Set a real domain for automatic HTTPS with Caddy.
SITE_ADDRESS=:80

# Retention and runtime tuning.
RECORD_DELETE_AFTER=168h
STATUS_INTERVAL_SECS=10
RECONCILE_INTERVAL_SECS=60
RUST_LOG=info,tower_http=info

